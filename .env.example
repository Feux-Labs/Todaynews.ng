# =============================================================================
# Todaynews.ng — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file with real secrets to version control.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Serverless Postgres connection string (Neon, Supabase, PlanetScale, etc.)
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/todaynews?sslmode=require"

# ── AI Engine ─────────────────────────────────────────────────────────────────
# Google Gemini API Key for AI rewriting, paraphrasing, and chat engine
GEMINI_API_KEY="AIzaSyYourGeminiKeyHere"
GEMINI_MODEL="gemini-1.5-flash"

# Image uploads for CMS featured images
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ── Site Identity ─────────────────────────────────────────────────────────────
# Public base URL used for SEO canonicals, sitemap, and OpenGraph tags
NEXT_PUBLIC_SITE_URL="https://todaynews.ng"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-key-here"
NEXTAUTH_URL="https://todaynews.ng"

# ── Admin Login ───────────────────────────────────────────────────────────────
# Default superadmin login password (change this immediately after first login)
ADMIN_DEFAULT_PASSWORD="todaynews2026"
# Email address to receive AI scraper alerts and story notifications
ADMIN_EMAIL="Admin@feuxlabs.ng"

# ── Zeptomail (Transactional Email) ───────────────────────────────────────────
# Get your API token from: https://www.zoho.com/zeptomail/
# Used for: new story alerts, approval notifications, admin digests
ZEPTOMAIL_TOKEN="your-zeptomail-api-token-here"
# The "From" address must be verified in your Zeptomail domain settings
EMAIL_FROM="\"Todaynews.ng AI\" <noreply@todaynews.ng>"

# ── Alternative SMTP (if not using Zeptomail) ────────────────────────────────
# Only needed if ZEPTOMAIL_TOKEN is not set. For Gmail: turn on 2-Step
# Verification, then create an App Password at myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your@email.com"
SMTP_PASS="your-app-password"

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"

# ── Adsterra Ad Units ─────────────────────────────────────────────────────────
# Publisher keys for active Adsterra ad placements
ADSTERRA_BANNER_300x250_KEY="baec4ba691aee8e6facd331480c3ff7a"
ADSTERRA_NATIVE_CONTAINER_ID="container-f98e29f0e52639872d03cd647118ee6b"
ADSTERRA_SOCIAL_BAR_SCRIPT="https://wailsilence.com/9a/e9/3b/9ae93b69d11e842af1c5c33415214763.js"

# ── Adsterra Smartlink (optional) ─────────────────────────────────────────────
# NEXT_PUBLIC_ADSTERRA_SMARTLINK="https://your-adsterra-smartlink-here"
