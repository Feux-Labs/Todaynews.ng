generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  POLITICS
  NAIRA
  ENTERTAINMENT
  SPORTS
  SECURITY
  METRO
  EDUCATION
  TECHNOLOGY
  HEALTH
  SCHOLARSHIP
  JAPA
  MAKE_MONEY_ONLINE
}

enum Status {
  AI_PENDING
  DRAFT
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
  REJECTED
  PENDING
}

enum AdminRole {
  SUPERADMIN
  EDITOR
  REVIEWER
}

model AdminUser {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  hashedPassword String
  role           AdminRole @default(EDITOR)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([email])
  @@index([active])
}

model Article {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  summary         String
  category        Category
  status          Status        @default(AI_PENDING)
  sourceUrl       String?
  sourceName      String?
  imageUrl        String?
  imageAlt        String?
  imageCredit     String?
  author          String        @default("TodaynewsAi")
  readTimeMinutes Int           @default(3)
  views           Int           @default(0)
  approvedById    String?
  scheduledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  pages           ArticlePage[]

  // System Design: High-performance compound indexes for queries
  @@index([status, createdAt(sort: Desc)])
  @@index([status, scheduledAt])
  @@index([status, category, createdAt(sort: Desc)])
  @@index([status, views(sort: Desc)])
  @@index([category])
  @@index([slug])
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Comment {
  id          String        @id @default(cuid())
  articleId   String
  authorName  String
  authorEmail String?
  content     String
  status      CommentStatus @default(PENDING)
  createdAt   DateTime      @default(now())

  @@index([articleId, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model AiChatMessage {
  id         String   @id @default(cuid())
  sessionId  String?
  role       String
  content    String
  storyCards Json?
  createdAt  DateTime @default(now())
  session    AiChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([createdAt(sort: Desc)])
}

model AiChatSession {
  id        String          @id @default(cuid())
  title     String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  AiChatMessage[]

  @@index([updatedAt(sort: Desc)])
}

model SiteSettings {
  id                 String   @id @default("singleton")
  defaultAuthorName  String
  defaultAuthorEmail String
  defaultAuthorBio   String
  siteName           String
  siteTagline        String
  contactEmail       String
  updatedAt          DateTime @updatedAt
}

model ArticlePage {
  id         String   @id @default(cuid())
  articleId  String
  pageNumber Int
  title      String?
  content    String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, pageNumber])
  @@index([articleId])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model PageView {
  id          String   @id @default(cuid())
  articleSlug String
  category    String?
  ipHash      String?
  userAgent   String?
  visitedAt   DateTime @default(now())

  // System Design: Indexing for fast time-series aggregation
  @@index([articleSlug])
  @@index([visitedAt(sort: Desc)])
  @@index([visitedAt, articleSlug])
  @@index([category])
}

model SponsoredAd {
  id        String   @id @default(cuid())
  title     String
  sponsor   String
  imageUrl  String
  targetUrl String
  category  String?
  badgeText String   @default("Sponsored")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([createdAt(sort: Desc)])
}
